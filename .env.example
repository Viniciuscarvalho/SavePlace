# Copy to an untracked .env for local commands. Never put a real secret here.
# Railway receives service variables in its deployment environment instead.

# Required by M1 migrations and persistence-enabled deployments. In Railway,
# inject the Postgres service reference as DATABASE_URL into the application
# service; never commit its real value.
DATABASE_URL=postgresql://user:password@host:5432/saveplace

# Required only to enable the authenticated Railway TikTok probe.
PROBE_TOKEN=

# Used only from a trusted terminal when running the Railway smoke test.
SAVEPLACE_PROBE_URL=https://your-service.up.railway.app

# Optional M0.3 structured extraction. Keep the key server-side only.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional M0.4 Google Places live contract and CLI resolution.
GOOGLE_MAPS_API_KEY=replace-with-your-restricted-google-maps-key

# Optional evaluation pricing copied from the active Google billing contract.
# Do not guess this value. When blank, evals report pricing_not_configured.
GOOGLE_PLACES_TEXT_SEARCH_PRICE_PER_UNIT_USD=
GOOGLE_PLACES_TEXT_SEARCH_PRICING_SOURCE=
GOOGLE_PLACES_TEXT_SEARCH_PRICING_EFFECTIVE_DATE=
