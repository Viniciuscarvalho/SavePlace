# Copy to an untracked .env for local commands. Never put a real secret here.
# Railway receives service variables in its deployment environment instead.

# Required by M1 migrations and persistence-enabled deployments. In Railway,
# inject the Postgres service reference as DATABASE_URL into the application
# service; never commit its real value.
DATABASE_URL=postgresql://user:password@host:5432/saveplace

# Required only to enable the authenticated Railway TikTok probe.
PROBE_TOKEN=

# Used only from a trusted terminal when running the Railway smoke test.
SAVEPLACE_PROBE_URL=https://your-service.up.railway.app

# Server-side operational gate for direct product and metrics API calls. It is
# never exposed to the browser.
API_TOKEN=
# Used only from a trusted terminal for the full remote persisted-session check.
SAVEPLACE_API_URL=https://your-service.up.railway.app
# Required only by the opt-in M2 Railway smoke. Use a URL known to resolve to
# a provider-verified place; it may call configured providers on a cache miss.
M2_SMOKE_TIKTOK_URL=

# Optional M0.3 structured extraction. Keep the key server-side only.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional M2.4 candidate-evidence support. This only labels extracted evidence;
# it never verifies an address or saves a place. Keep the key server-side only.
TYPESAFE_API_KEY=

# Optional M1.2 official Instagram acquisition. Both values are required for
# Instagram URLs; leave them blank to fail safely without an outbound request.
INSTAGRAM_OEMBED_ACCESS_TOKEN=
# Replace vXX.X with a currently supported Graph API version before use.
INSTAGRAM_OEMBED_ENDPOINT=https://graph.facebook.com/vXX.X/instagram_oembed
# Used only by the opt-in live Instagram contract test.
INSTAGRAM_OEMBED_TEST_URL=

# Optional M0.4 Google Places live contract and CLI resolution.
GOOGLE_MAPS_API_KEY=replace-with-your-restricted-google-maps-key

# Optional evaluation pricing copied from the active Google billing contract.
# Do not guess this value. When blank, evals report pricing_not_configured.
GOOGLE_PLACES_TEXT_SEARCH_PRICE_PER_UNIT_USD=
GOOGLE_PLACES_TEXT_SEARCH_PRICING_SOURCE=
GOOGLE_PLACES_TEXT_SEARCH_PRICING_EFFECTIVE_DATE=

# Maximum uncached pipeline starts for one anonymous browser session in a UTC
# calendar month. Cache hits and idempotency replays do not consume this limit.
SAVEPLACE_USER_ANALYSIS_LIMIT=10
