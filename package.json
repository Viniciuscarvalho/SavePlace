{
  "name": "saveplace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Multimodal place extraction and resolution spike",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "analyze": "tsx src/cli/analyze.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:tiktok": "RUN_TIKTOK_INTEGRATION=1 vitest run tests/tiktok-source.integration.test.ts",
    "test:integration:google-places": "RUN_GOOGLE_PLACES_INTEGRATION=1 vitest run tests/google-places-provider.integration.test.ts",
    "test:railway:smoke": "tsx src/cli/smoke-railway.ts",
    "eval:m0": "tsx src/cli/eval-m0.ts",
    "eval:m0:live": "RUN_M0_EVAL_LIVE=1 tsx src/cli/eval-m0.ts --live",
    "eval:m0:gate": "RUN_M0_EVAL_LIVE=1 tsx src/cli/eval-m0.ts --live --gate"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
